# Viva Energia: variáveis de ambiente (valores de exemplo, nunca reais).

# Banco. No Railway: DATABASE_URL=${{Postgres.DATABASE_URL}} (rede interna).
DATABASE_URL=postgresql://postgres:senha@localhost:5434/viva_local

# Endereço público (redirecionamentos, URL OCPP mostrada no painel).
APP_URL=http://localhost:3400
PORT=3400

# Assinatura das sessões e senha dos carregadores simulados. 32+ caracteres,
# diferente por ambiente. Trocar derruba todas as sessões.
SESSION_SECRET=troque-por-um-valor-aleatorio-com-48-caracteres-ou-mais

# Primeiro administrador (só é criado com a tabela de usuários vazia).
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@vivaenergia.local
INITIAL_ADMIN_PASSWORD=troque-esta-senha

# Carregadores simulados (painel > Simulador). "sim" liga em produção;
# em desenvolvimento já vem ligado. Desligar quando só houver equipamento real.
OCPP_SIMULADOR=sim

# Pagamentos da carteira (Pix e cartão). Por enquanto só "simulado" (nada é cobrado).
PAGAMENTOS_PROVEDOR=simulado

# E-mail (recuperação de senha). Sem chave, em desenvolvimento o link aparece no log.
RESEND_API_KEY=
EMAIL_REMETENTE=Viva Energia <nao-responda@seudominio.com.br>

# Mapa do app. Padrão: OpenStreetMap (só para teste; em produção usar provedor com cota, ex. MapTiler).
MAPA_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAPA_ATRIBUICAO=&copy; OpenStreetMap
